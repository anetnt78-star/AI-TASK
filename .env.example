# ─────────────────────────────────────────────────────────────────────────────
# Slack 휴가 알림 예약 스케줄러 – 환경 변수 설정
# ─────────────────────────────────────────────────────────────────────────────
# 이 파일을 복사해서 .env 로 저장하고 실제 값을 채우세요.
#   cp .env.example .env
# .env 파일은 절대 git에 커밋하지 마세요 (.gitignore 에 포함되어 있습니다).
# ─────────────────────────────────────────────────────────────────────────────

# Slack Bot Token
# 형식: xoxb-XXXXXXXXXXX-XXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXX
# 발급 경로: https://api.slack.com/apps → 앱 선택 → OAuth & Permissions → Bot User OAuth Token
# 필요 스코프: chat:write
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# 메시지를 발송할 채널의 ID (#00-디지털서비스유닛)
# 형식: C로 시작하는 11자리 영숫자  예) C0XXXXXXXXX
# 확인 방법:
#   1. Slack 앱에서 채널 이름 우클릭 → 채널 세부 정보 복사 → 맨 아래 채널 ID 확인
#   2. 또는 find_channel_id.py 실행:  python find_channel_id.py 00-디지털서비스유닛
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Backup 담당자 기본값 (--backup 옵션으로 실행 시마다 덮어쓸 수 있음)
DEFAULT_BACKUP_PERSON=고승열
